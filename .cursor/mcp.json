{
  "mcpServers": {
    "coplay-mcp": {
      "disabled": false,
      "timeout": 720,
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        ">=3.11",
        "coplay-mcp-server@latest"
      ],
      "env": {
        "MCP_TOOL_TIMEOUT": "720000"
      }
    }
  }
}
